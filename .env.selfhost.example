# Copy to .env.selfhost and replace every CHANGE_ME value before first start.
# Production deployments should place the populated file at /etc/ledgerly/ledgerly.env with mode 0600.
LEDGERLY_SITE_ADDRESS=http://localhost
LEDGERLY_HTTP_PORT=8080
LEDGERLY_HTTPS_PORT=8443
LEDGERLY_MAX_REQUEST_BODY=64MB
LEDGERLY_MAX_REQUEST_BODY_BYTES=67108864
LEDGERLY_TRUST_PROXY_HEADERS=true
LEDGERLY_RATE_LIMIT_WINDOW_MS=60000
LEDGERLY_RATE_LIMIT_MAX_REQUESTS=600

# Rehearsal defaults. Production validation requires tested immutable @sha256 digests for every base/service image.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
CADDY_IMAGE=caddy:2-alpine
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.21.0
NODE_BASE_IMAGE=node:20-alpine
PGBOUNCER_BASE_IMAGE=alpine:3.22

POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5432
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_ADMIN_RESERVED_CONNECTIONS=20
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=60s
POSTGRES_LOCK_TIMEOUT=15s
POSTGRES_LOG_MIN_DURATION_MS=1000

PGBOUNCER_HOST_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=70
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_QUERY_TIMEOUT=120
PGBOUNCER_CLIENT_IDLE_TIMEOUT=300
PGBOUNCER_IDLE_TRANSACTION_TIMEOUT=60
PGBOUNCER_SERVER_IDLE_TIMEOUT=600
PGBOUNCER_SERVER_LIFETIME=3600

# Production API traffic must use this non-superuser role. Leave blank only for initial rehearsal,
# then set both values and run selfhost/postgres/provision-app-role.sh before production validation.
LEDGERLY_DATABASE_APP_USER=
LEDGERLY_DATABASE_APP_PASSWORD=

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_HOST_PORT=6379

# Root credentials are reserved for MinIO administration/backups. Production API traffic uses
# the bucket-scoped application credentials created by the minio-bootstrap service.
MINIO_ROOT_USER=ledgerly
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
MINIO_APP_ACCESS_KEY=ledgerly-app
MINIO_APP_SECRET_KEY=CHANGE_ME_STRONG_MINIO_APP_PASSWORD
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_DEFAULT_BUCKET=ledgerly
MINIO_REGION=us-east-1

LEDGERLY_API_PORT=8788
LEDGERLY_ENVIRONMENT=development
LEDGERLY_RUNTIME_MODE=foundation
LEDGERLY_DEPENDENCY_TIMEOUT_MS=1500
LEDGERLY_DATABASE_POOL_MAX=20
LEDGERLY_DATABASE_IDLE_TIMEOUT_MS=30000
LEDGERLY_REDIS_DATABASE=0
LEDGERLY_REDIS_NAMESPACE=ledgerly:selfhost
LEDGERLY_QUEUE_NAME=core
LEDGERLY_QUEUE_MAX_ATTEMPTS=5
LEDGERLY_SCHEDULER_ENABLED=true
LEDGERLY_SCHEDULER_POLL_INTERVAL_MS=5000
LEDGERLY_SCHEDULER_CLAIM_LIMIT=20
LEDGERLY_SCHEDULER_LOCK_TIMEOUT_MS=300000
LEDGERLY_SCHEDULER_WORKER_ID=

# Shared module registry. This must move with modular business applications so local organizations
# can enable/disable modules without falling back to the Cloudflare API.
LEDGERLY_PLATFORM_MODULES_SELFHOST_ENABLED=false
LEDGERLY_PLATFORM_MODULES_CUTOVER=cloudflare

# School cutovers are deliberately split by capability. Keep Cloudflare authoritative until the
# matching PostgreSQL schema/data validation has passed. The local rehearsal helper enables only
# reference/setup reads+writes and people reads; people writes remain on Cloudflare.
LEDGERLY_SCHOOL_SELFHOST_ENABLED=false
LEDGERLY_SCHOOL_REFERENCE_READ_CUTOVER=cloudflare
LEDGERLY_SCHOOL_REFERENCE_WRITE_CUTOVER=cloudflare
LEDGERLY_SCHOOL_PEOPLE_READ_CUTOVER=cloudflare
LEDGERLY_SCHOOL_PEOPLE_WRITE_CUTOVER=cloudflare

# Human Resources is a coherent non-payroll domain. Payroll remains independently gated.
LEDGERLY_HR_SELFHOST_ENABLED=false
LEDGERLY_HR_CUTOVER=cloudflare

# Shared Contacts directory. Keep Cloudflare authoritative until its PostgreSQL validation succeeds.
LEDGERLY_CONTACTS_SELFHOST_ENABLED=false
LEDGERLY_CONTACTS_CUTOVER=cloudflare

# Communications uses PostgreSQL for campaigns/deliveries, Redis for durable work and the common
# notification bridge for SMS/WhatsApp/email. Provider credentials remain optional in rehearsal.
LEDGERLY_COMMUNICATIONS_SELFHOST_ENABLED=false
SELFHOST_COMMUNICATIONS_ENABLED=false
LEDGERLY_COMMUNICATIONS_CUTOVER=cloudflare
LEDGERLY_COMMUNICATIONS_BATCH_SIZE=100
LEDGERLY_COMMUNICATIONS_POLL_MS=500
LEDGERLY_COMMUNICATIONS_MAX_ATTEMPTS=5
LEDGERLY_COMMUNICATIONS_SCHEDULE_CRON=* * * * *

# Attendance is independently gated. The biometric key is required only for face-template
# enrollment/decryption and must be 32 random bytes encoded as base64.
LEDGERLY_ATTENDANCE_SELFHOST_ENABLED=false
SELFHOST_ATTENDANCE_ENABLED=false
LEDGERLY_ATTENDANCE_CUTOVER=cloudflare
BIOMETRIC_ENCRYPTION_KEY=

# Academics covers teaching operations only: timetables, schemes, lesson plans/delivery,
# supervision and inspections. Exams stay on their own independent module/cutover.
LEDGERLY_ACADEMICS_SELFHOST_ENABLED=false
SELFHOST_ACADEMICS_ENABLED=false
LEDGERLY_ACADEMICS_CUTOVER=cloudflare

# Printerly cutovers are granular and default to Cloudflare. The broad switch is retained only as a
# compatibility fallback for child switches that are not explicitly set; it does not claim the root
# /api/v1/printerly namespace. Move the node-appliance path first, then jobs/documents/approvals.
LEDGERLY_PRINTERLY_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_NODE_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_JOB_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_SCANNER_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_CORE_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_GOVERNANCE_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_BATCH_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_ROUTING_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_RELEASE_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_RETENTION_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_SUPPLIES_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_PROCUREMENT_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_SERVICE_DESK_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_AUDIT_CUTOVER=cloudflare
LEDGERLY_PRINTERLY_OUTBOX_POLL_MS=2000
LEDGERLY_PRINTERLY_WORKER_POLL_MS=1000

LEDGERLY_JWT_ISSUER=your-finance-pro
LEDGERLY_JWT_AUDIENCE=your-finance-pro-api
LEDGERLY_JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
LEDGERLY_ACCESS_TOKEN_TTL_SECONDS=900
LEDGERLY_REFRESH_TOKEN_TTL_DAYS=30
# Auth stays on Cloudflare until auth/core migration validation is complete. Move each surface to
# node only when PostgreSQL contains the required auth data and the cutover has been approved.
LEDGERLY_AUTH_LOGIN_CUTOVER=cloudflare
LEDGERLY_AUTH_REGISTER_CUTOVER=cloudflare

LEDGERLY_NOTIFICATION_TIMEOUT_MS=10000
LEDGERLY_NOTIFICATION_REQUIRED_CHANNELS=
EGOSMS_API_URL=https://www.egosms.co/api/v1/plain/
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
EGOSMS_SENDER_ID=
WHATSAPP_SUPPORT_HUB_URL=
WHATSAPP_SUPPORT_APP_KEY=
LEDGERLY_WHATSAPP_TEMPLATE=general_app_update
LEDGERLY_WHATSAPP_LANGUAGE=en_US
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

LEDGERLY_OBJECT_STORAGE_SSL=false
LEDGERLY_OBJECT_STORAGE_CREATE_BUCKET=false
LEDGERLY_STORAGE_PATH=/var/lib/ledgerly/storage

# Local/offline AI Workforce. Disabled until migration/model readiness is proven.
LEDGERLY_AI_ENABLED=false
LEDGERLY_AI_PROVIDER=ollama
LEDGERLY_AI_ENDPOINT=http://ollama:11434
LEDGERLY_AI_MODEL=
LEDGERLY_AI_TIMEOUT_MS=60000
LEDGERLY_AI_CONTEXT_LIMIT=8192
LEDGERLY_AI_TEMPERATURE=0.2
LEDGERLY_AI_TOOL_SUPPORT=true
LEDGERLY_AI_WORKER_ENABLED=true
LEDGERLY_AI_QUEUE_NAME=ai-workforce
LEDGERLY_AI_MAX_CONCURRENCY=2
LEDGERLY_AI_MAX_RETRIES=2
LEDGERLY_AI_TASK_TIMEOUT_MS=120000
LEDGERLY_AI_MAX_PROMPT_CHARS=48000
LEDGERLY_AI_MAX_OUTPUT_CHARS=32000
LEDGERLY_AI_MAX_TOOL_CALLS=12
LEDGERLY_AI_MAX_HANDOFFS=3
LEDGERLY_AI_EMBEDDING_DIMENSIONS=768
LEDGERLY_AI_POLL_INTERVAL_MS=500
LEDGERLY_AI_MAX_KNOWLEDGE_BYTES=26214400
LEDGERLY_AI_CHUNK_CHARS=3200
LEDGERLY_AI_CHUNK_OVERLAP_CHARS=400

# NVR/media host bindings. RTSP/HLS/WHEP HTTP remain loopback/private in the reviewed overlay.
CAMERA_RTSP_HOST_PORT=8554
CAMERA_HLS_HOST_PORT=8888
CAMERA_WEBRTC_HTTP_HOST_PORT=8889
CAMERA_WEBRTC_UDP_PORT=8189
CAMERA_STORAGE_ROOT=./camera-storage

# Operations thresholds. Production validation also requires encrypted off-site backup and recent restore proof.
OPS_DISK_CRITICAL_PERCENT=90
OPS_NVR_DISK_CRITICAL_PERCENT=90
BACKUP_FRESHNESS_SECONDS=93600
RESTORE_TEST_REQUIRED=false
RESTORE_TEST_FRESHNESS_SECONDS=691200

# One-shot D1 -> PostgreSQL migration profile. Cloudflare credentials go only to the migration container.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
LEDGERLY_MIGRATION_PHASE=auth-core
LEDGERLY_D1_MIGRATION_BATCH_SIZE=250
LEDGERLY_D1_MIGRATION_HTTP_TIMEOUT_MS=15000
LEDGERLY_MIGRATION_DATABASE_POOL_MAX=4

# Final cutover/readiness checks. Point these at the rehearsal/self-hosted server, never at Cloudflare.
LEDGERLY_SELFHOST_BASE_URL=http://127.0.0.1:8788
LEDGERLY_BACKUP_ROOT=/backups
LEDGERLY_BACKUP_MAX_AGE_HOURS=26
LEDGERLY_READINESS_DATABASE_POOL_MAX=2
LEDGERLY_READINESS_HTTP_TIMEOUT_MS=5000
# Leave blank to require evidence for every registered migration phase.
LEDGERLY_READINESS_PHASES=

# Bounded GET-only load smoke. Defaults target /selfhost/ready so it cannot mutate business data.
LEDGERLY_LOAD_PATH=/selfhost/ready
LEDGERLY_LOAD_REQUESTS=200
LEDGERLY_LOAD_CONCURRENCY=10
LEDGERLY_LOAD_TIMEOUT_MS=5000
LEDGERLY_LOAD_MAX_ERROR_RATE=0.01
LEDGERLY_LOAD_MAX_P95_MS=1000

# Disposable restore drill. The database name MUST begin with ledgerly_restore_test_.
LEDGERLY_TEST_RESTORE_DATABASE=
LEDGERLY_TEST_RESTORE_KEEP_DATABASE=0
PGMAINTENANCE_DB=postgres
