# Copy to .env.selfhost and replace every CHANGE_ME value before first start.
LEDGERLY_SITE_ADDRESS=http://localhost
LEDGERLY_HTTP_PORT=8080
LEDGERLY_HTTPS_PORT=8443

POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MAX_CLIENT_CONN=1000

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_HOST_PORT=6379

MINIO_ROOT_USER=ledgerly
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_DEFAULT_BUCKET=ledgerly
MINIO_REGION=us-east-1

# Local Ollama runtime. No model is hardcoded; install/select models explicitly.
OLLAMA_HOST_PORT=11434

# Self-hosted Node migration runtime. Business routes remain disabled until migrated domains pass integrity tests.
LEDGERLY_API_PORT=8788
LEDGERLY_ENVIRONMENT=development
LEDGERLY_RUNTIME_MODE=foundation
LEDGERLY_DEPENDENCY_TIMEOUT_MS=1500
LEDGERLY_DATABASE_POOL_MAX=20
LEDGERLY_DATABASE_IDLE_TIMEOUT_MS=30000
LEDGERLY_REDIS_DATABASE=0
LEDGERLY_REDIS_NAMESPACE=ledgerly:selfhost
LEDGERLY_QUEUE_NAME=core
LEDGERLY_QUEUE_MAX_ATTEMPTS=5
LEDGERLY_SCHEDULER_ENABLED=true
LEDGERLY_SCHEDULER_POLL_INTERVAL_MS=5000
LEDGERLY_SCHEDULER_CLAIM_LIMIT=20
LEDGERLY_SCHEDULER_LOCK_TIMEOUT_MS=300000
# Optional fixed ID for a single server. Leave blank to generate host:pid:uuid at runtime.
LEDGERLY_SCHEDULER_WORKER_ID=

# Auth compatibility. Keep issuer/audience/secret aligned with the current Worker during dual-run.
LEDGERLY_JWT_ISSUER=your-finance-pro
LEDGERLY_JWT_AUDIENCE=your-finance-pro-api
LEDGERLY_JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
LEDGERLY_ACCESS_TOKEN_TTL_SECONDS=900
LEDGERLY_REFRESH_TOKEN_TTL_DAYS=30

# Local/offline-first AI Workforce. The provider/model boundary is configurable.
LEDGERLY_AI_ENABLED=true
LEDGERLY_AI_PROVIDER=ollama
LEDGERLY_AI_ENDPOINT=http://ollama:11434
LEDGERLY_AI_MODEL=
LEDGERLY_AI_EMBEDDING_MODEL=
LEDGERLY_AI_EMBEDDING_DIMENSIONS=768
LEDGERLY_AI_TIMEOUT_MS=60000
LEDGERLY_AI_CONTEXT_LIMIT=8192
LEDGERLY_AI_TEMPERATURE=0.2
LEDGERLY_AI_TOOL_SUPPORT=true
LEDGERLY_AI_WORKER_ENABLED=true
LEDGERLY_AI_QUEUE_NAME=ai-workforce
LEDGERLY_AI_MAX_CONCURRENCY=2
LEDGERLY_AI_MAX_RETRIES=2
LEDGERLY_AI_TASK_TIMEOUT_MS=120000
LEDGERLY_AI_MAX_PROMPT_CHARS=48000
LEDGERLY_AI_MAX_OUTPUT_CHARS=32000
LEDGERLY_AI_MAX_TOOL_CALLS=12
LEDGERLY_AI_MAX_HANDOFFS=3
LEDGERLY_AI_POLL_INTERVAL_MS=500

# Notification bridge. Leave LEDGERLY_NOTIFICATION_REQUIRED_CHANNELS empty during foundation work.
# Before production, set it to the channels that must be configured, e.g. email,sms,whatsapp.
LEDGERLY_NOTIFICATION_TIMEOUT_MS=10000
LEDGERLY_NOTIFICATION_REQUIRED_CHANNELS=
EGOSMS_API_URL=https://www.egosms.co/api/v1/plain/
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
EGOSMS_SENDER_ID=
WHATSAPP_SUPPORT_HUB_URL=
WHATSAPP_SUPPORT_APP_KEY=
LEDGERLY_WHATSAPP_TEMPLATE=general_app_update
LEDGERLY_WHATSAPP_LANGUAGE=en_US
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

LEDGERLY_OBJECT_STORAGE_SSL=false
LEDGERLY_OBJECT_STORAGE_CREATE_BUCKET=true
LEDGERLY_STORAGE_PATH=/var/lib/ledgerly/storage

# One-shot D1 -> PostgreSQL migration profile. These Cloudflare credentials are passed only to the migration container,
# never to the long-running Ledgerly API service. Use a narrowly scoped D1 read token and rotate/revoke it after cutover.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
# Select one registered migration phase. auth-core must complete before school-reference can run.
LEDGERLY_MIGRATION_PHASE=auth-core
LEDGERLY_D1_MIGRATION_BATCH_SIZE=250
LEDGERLY_D1_MIGRATION_HTTP_TIMEOUT_MS=15000
LEDGERLY_MIGRATION_DATABASE_POOL_MAX=4
