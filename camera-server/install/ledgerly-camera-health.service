[Unit]
Description=Verify Ledgerly Camera Server and MediaMTX health and recover only the failed component
After=ledgerly-camera.service docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=__SERVER_DIR__
EnvironmentFile=-/etc/ledgerly-camera/camera.env
ExecStart=__SERVER_DIR__/scripts/healthcheck.sh
