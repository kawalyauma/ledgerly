{
  "key": "audio-calls",
  "name": "Audio Calls",
  "version": "1.0.0",
  "description": "Secure organization-wide WebRTC audio calling for Ledgerly workers, with presence, ringing, call history and internet-ready ICE/TURN support.",
  "category": "collaboration",
  "active": true,
  "scopes": [
    "audio-calls:read",
    "audio-calls:write"
  ],
  "navigation": [
    {
      "key": "audio-calls",
      "label": "Calls",
      "path": "/audio-calls",
      "icon": "phone"
    }
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "allowExternalNetworks": { "type": "boolean", "default": true },
      "ringTimeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 120, "default": 35 },
      "recordingEnabled": { "type": "boolean", "default": false }
    }
  },
  "manifest": {
    "media": "webrtc-audio",
    "recordingDefault": false,
    "supports": ["one-to-one", "presence", "call-history", "stun", "turn"]
  }
}
