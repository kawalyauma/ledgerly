[Unit]
Description=Ledgerly Printerly Node
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=printerly
Group=lp
Environment=PRINTERLY_HOME=/etc/printerly
Environment=PRINTERLY_CONFIG=/etc/printerly/config.json
ExecStart=/usr/bin/node /opt/printerly/src/agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/printerly /var/lib/printerly

[Install]
WantedBy=multi-user.target
