{
  "name": "@ledgerly/selfhost-server",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Ledgerly Node runtime foundation",
  "scripts": {
    "start": "node src/index.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "migration:phases": "node src/migration/cli.mjs phases",
    "migration:plan": "node src/migration/cli.mjs plan",
    "migration:run": "node src/migration/cli.mjs run",
    "migration:validate": "node src/migration/cli.mjs validate",
    "migration:rehearsal": "node src/migration/rehearsal-cli.mjs"
  },
  "dependencies": {
    "cron-parser": "5.10.0",
    "jose": "6.1.0",
    "minio": "8.0.7",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "redis": "6.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
