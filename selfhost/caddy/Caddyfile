{
  admin off
}

{$LEDGERLY_SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    -Server
  }

  handle /healthz {
    respond "ledgerly-selfhost-edge-ok" 200
  }

  # Foundation-only Node runtime. No business routes are cut over yet.
  handle /selfhost/* {
    reverse_proxy api:8788
  }

  handle {
    respond "Ledgerly self-hosted edge is running. API/web cutover is not enabled yet." 503
  }
}
