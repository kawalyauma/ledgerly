#!/usr/sbin/nft -f
# REVIEW BEFORE APPLYING. Replace the example SSH subnet so you do not lock yourself out.
flush table inet ledgerly_filter

table inet ledgerly_filter {
  set admin4 {
    type ipv4_addr
    flags interval
    elements = { 192.0.2.0/24 }
  }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iifname "lo" accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # Administrative SSH is never open to the whole Internet in this template.
    ip saddr @admin4 tcp dport 22 ct state new limit rate 20/minute burst 10 packets accept

    # Public Caddy TLS/HTTP. This is a connection-rate safety net, not an HTTP
    # request-rate limiter; application/edge policy still owns per-user/API limits.
    tcp dport { 80, 443 } ct state new limit rate 120/second burst 240 packets accept

    # Optional MediaMTX WebRTC UDP. Remove this rule if WebRTC is VPN/LAN-only.
    udp dport 8189 accept

    counter drop
  }

  chain forward { type filter hook forward priority 0; policy accept; }
  chain output { type filter hook output priority 0; policy accept; }
}
