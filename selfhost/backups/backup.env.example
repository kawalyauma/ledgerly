# Copy to /etc/ledgerly/backup.env and chmod 600. Never commit the populated file.
BACKUP_ROOT=/var/backups/ledgerly
BACKUP_RETENTION_DAYS=30
BACKUP_FRESHNESS_SECONDS=93600
BACKUP_MIN_FREE_BYTES=5368709120
LEDGERLY_REPO_ROOT=/opt/ledgerly
LEDGERLY_ENV_FILE=/etc/ledgerly/ledgerly.env
LEDGERLY_COMPOSE_FILE=/opt/ledgerly/compose.selfhost.yml

# Encrypted off-site backups (Restic). Production validation requires this to be configured.
# Examples: s3:https://s3.example.invalid/ledgerly-backups or /mnt/offsite/ledgerly-restic
RESTIC_REPOSITORY=
# Store the password in this root-readable file; do not put the password in this env file.
RESTIC_PASSWORD_FILE=/etc/ledgerly/secrets/restic-password
RESTIC_CHECK_SUBSET=5%
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12

# Weekly restore rehearsal. It creates/removes a scratch PostgreSQL database and temporary MinIO bucket.
LEDGERLY_TEST_RESTORE_MINIO=true
RESTORE_TEST_REQUIRED=true
RESTORE_TEST_FRESHNESS_SECONDS=691200
